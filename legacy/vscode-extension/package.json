{
  "name": "math-workspace-vscode-extension",
  "displayName": "Math Workspace",
  "description": "Legacy VS Code-compatible preview integration for math-workspace",
  "private": true,
  "deprecated": "Archived with math-workspace 0.1.0. Use the local Reader via `math-workspace serve` instead.",
  "version": "0.1.0",
  "publisher": "glenzli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/glenzli/math-workspace.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/",
    "media/",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/styles.css"
    ],
    "markdown.previewScripts": [
      "./media/formal-script.js"
    ],
    "commands": [
      {
        "command": "math-workspace.refreshIndex",
        "title": "Math Workspace: Refresh References"
      }
    ]
  }
}
