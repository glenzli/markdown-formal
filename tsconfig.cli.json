{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "rootDir": ".",
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@markdown-formal/core": ["packages/core/src/formal-core.ts"],
      "@markdown-formal/core/*": ["packages/core/src/*"]
    }
  },
  "include": ["src/cli/**/*", "src/mcp/**/*.ts", "src/reader/*.ts", "packages/core/src/**/*", "src/node.d.ts"]
}
