{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2022"],
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@markdown-formal/core": ["packages/core/src/formal-core.ts"],
      "@markdown-formal/core/*": ["packages/core/src/*"]
    }
  },
  "include": [
    "packages/core/src/**/*",
    "packages/vscode-extension/src/**/*",
    "src/node.d.ts"
  ]
}
